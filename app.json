{
  "expo": {
    "name": "Neşeli Kamyon Tır Pazarı",
    "slug": "neselii-app-mui",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "neseliotomotiv",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.neseliotomotiv.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A213F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.neseliotomotiv.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A213F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-sqlite",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Konumunuz yalnızca ilanları size olan uzaklığa göre sıralamak için kullanılır.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#18A749"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "İlan fotoğraf ve videolarını yüklemek için galerinize erişim gerekir.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "be72ecf3-0dd3-44c0-ba2e-be70935c4cdc"
      }
    },
    "owner": "muimedya",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/be72ecf3-0dd3-44c0-ba2e-be70935c4cdc"
    }
  }
}
